{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && npm run build:api",
    "build:api": "esbuild server/vercelEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=server-build/api.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js server-build",
    "lint": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/*.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "//overrides": "jwks-rsa (via firebase-admin) faz require('jose'), mas declara jose ^6 — que é ESM-only. Em Node >=22.12 (nosso local) require(ESM) funciona e o problema não aparece; no runtime da Vercel NÃO, e a função morre com ERR_REQUIRE_ESM no carregamento. jose 5 publica build CJS e mantém importJWK/exportSPKI (as duas únicas APIs que o jwks-rsa usa).",
  "overrides": {
    "jose": "^5.10.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.1.0",
    "lucide-react": "^0.546.0",
    "mercadopago": "^3.2.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.23.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
