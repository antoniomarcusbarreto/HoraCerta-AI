# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (opcional): id do modelo usado nos scanners. Default:
# "gemini-2.5-flash". O antigo "gemini-3.5-flash" NÃO é um id de modelo válido —
# confirme o id na lista atual de modelos Gemini antes de subir em produção.
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, API endpoints, and as the
# allowed CORS origin for the /api/gemini/* routes.
APP_URL="MY_APP_URL"

# --- Credenciais do Firebase Admin (servidor) — escolha UMA das duas formas ---
#
# (A) VERCEL / serverless (RECOMENDADO em produção): cole o JSON COMPLETO da
# conta de serviço em UMA linha nesta variável. Na Vercel não existe filesystem
# com o arquivo nem Application Default Credentials, então sem isto verifyIdToken,
# o Firestore Admin e o webhook do Mercado Pago FALHAM em runtime.
FIREBASE_SERVICE_ACCOUNT=""
#
# (B) Cloud Run / local: caminho para o JSON da conta de serviço. Usado como
# Application Default Credentials. Em Cloud Run/GCP com service account anexada,
# nem isto é necessário. É também o que server/setAdminClaim.js usa.
GOOGLE_APPLICATION_CREDENTIALS="./service-account.json"

# ==========================================
# WEB PUSH (VAPID) — lembretes de dose com o app fechado
# ==========================================

# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY: par de chaves VAPID usado para assinar
# as mensagens de push. Gere UMA vez com `node server/generateVapidKeys.js` e
# guarde aqui (dev) ou no painel de secrets (prod). A pública é exposta ao
# navegador; a privada é segredo de servidor e nunca deve ir para o Git.
# Se estas variáveis estiverem ausentes o servidor ainda sobe, apenas com o
# push desligado (as notificações só-com-app-aberto continuam funcionando).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# VAPID_SUBJECT: contato do responsável pelo envio (exigido pelo protocolo).
# Deve ser uma URL mailto: ou https:.
VAPID_SUBJECT="mailto:contato@horacerta.ai"

# FIREBASE_DATABASE_ID: id do banco Firestore nomeado que o dispatcher de push
# lê via Admin SDK. Deve casar com firestoreDatabaseId em
# firebase-applet-config.json. Se omitido, cai nesse arquivo automaticamente.
FIREBASE_DATABASE_ID=""

# ENABLE_PUSH_SCHEDULER: quando != "false", o próprio processo do servidor roda
# o dispatcher de lembretes a cada minuto (ideal para Node long-running: dev,
# `npm start`, Cloud Run). Em plataformas serverless (Vercel), defina "false" e
# use um Vercel Cron chamando POST /api/push/dispatch com o header
# Authorization: Bearer $CRON_SECRET.
ENABLE_PUSH_SCHEDULER="true"

# CRON_SECRET: segredo que protege o endpoint /api/push/dispatch. Gere um valor
# aleatório longo. Na Vercel, defina esta variável e o Vercel Cron enviará
# automaticamente o header Authorization: Bearer $CRON_SECRET nas chamadas
# agendadas (ver "crons" em vercel.json, que dispara /api/push/dispatch a cada
# minuto — exige plano da Vercel que permita cron minuto a minuto).
CRON_SECRET=""

# ==========================================
# MERCADO PAGO — assinaturas (PIX + Cartão)
# ==========================================

# MP_ACCESS_TOKEN: token de acesso da sua conta Mercado Pago (Suas integrações
# → Credenciais). É um SEGREDO de servidor — nunca vai para o Git nem para o
# cliente. Use as credenciais de TESTE para homologar e as de PRODUÇÃO no ar.
# Sem ele, os endpoints /api/subscription/* respondem com erro claro, mas o
# servidor continua subindo normalmente.
MP_ACCESS_TOKEN=""

# MP_WEBHOOK_SECRET: "Assinatura secreta" do webhook (painel do Mercado Pago →
# Webhooks/Notificações). Usada para validar o HMAC do header x-signature em
# POST /api/mercadopago/webhook. Se estiver ausente, TODO webhook é rejeitado
# (fail-closed) — configure antes de receber pagamentos reais.
MP_WEBHOOK_SECRET=""

# Lembrete: registre a URL pública do webhook no painel do Mercado Pago apontando
# para  <APP_URL>/api/mercadopago/webhook  e ative o PIX na sua conta.
