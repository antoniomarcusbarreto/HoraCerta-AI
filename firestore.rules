rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // GLOBAL Safety Net
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // GLOBAL PRIMITIVES & HELPERS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin check driven exclusively by the Firebase custom claim `admin: true`,
    // granted out-of-band via the Admin SDK (see server/setAdminClaim.js). Never
    // trust client-supplied fields (email, role, etc.) for authorization.
    function isAdmin() {
      return isSignedIn() &&
             isEmailVerified() &&
             request.auth.token.admin == true;
    }

    // ------------------------------------------
    // COMPARTILHAMENTO ENTRE CUIDADORES
    // ------------------------------------------
    // Um medicado pode ser compartilhado com outros cuidadores. Cada documento
    // da subárvore carrega duas listas: `memberUids` (quem lê) e `editorUids`
    // (subconjunto que também escreve).
    //
    // O TITULAR nunca entra nessas listas — o acesso dele vem do caminho
    // (`request.auth.uid == userId`). Consequência deliberada: todo documento
    // criado antes desta feature, sem os campos, continua válido e acessível
    // pelo dono. Não existe migração, nem janela de inconsistência.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isMember(data) {
      return isSignedIn() &&
             'memberUids' in data &&
             request.auth.uid in data.memberUids;
    }

    function isEditor(data) {
      return isSignedIn() &&
             'editorUids' in data &&
             request.auth.uid in data.editorUids;
    }

    // As listas de acesso são gravadas EXCLUSIVAMENTE pelo servidor (Admin SDK,
    // que bypassa estas regras) no aceite e na revogação do convite. Nenhum
    // cliente pode alterá-las em um update — nem o titular. Deixar o cliente
    // escrever aqui seria permitir conceder acesso a dado de saúde de terceiro
    // sem o consentimento de quem recebe.
    function shareListsUnchanged() {
      return !incoming().diff(existing()).affectedKeys().hasAny(['memberUids', 'editorUids']);
    }

    // Na CRIAÇÃO um coadministrador precisa carimbar as listas no documento
    // novo, senão o registro que ele cria nasce invisível para os demais
    // cuidadores. Para que isso não vire escalação de privilégio, as listas têm
    // de ser idênticas às do medicado pai — nunca escolhidas pelo cliente.
    function medicadoData(userId, medicadoId) {
      return get(/databases/$(database)/documents/users/$(userId)/medicados/$(medicadoId)).data;
    }

    function inheritsShareLists(data, parent) {
      return (!('memberUids' in data) || data.memberUids == parent.memberUids) &&
             (!('editorUids' in data) || data.editorUids == parent.editorUids);
    }

    function hasNoShareLists(data) {
      return !('memberUids' in data) && !('editorUids' in data);
    }

    // Aplicado a toda entidade compartilhável: tipos e teto de tamanho.
    function isValidShareLists(data) {
      return (!('memberUids' in data) || (data.memberUids is list && data.memberUids.size() <= 20)) &&
             (!('editorUids' in data) || (data.editorUids is list && data.editorUids.size() <= 20));
    }

    // Check if the current user profile is active (not suspended).
    // FAILS CLOSED when the profile doc doesn't exist: this is what actually
    // gates every write into a user's tree, so a hard-deleted account (whose
    // users/{uid} doc was just recursiveDelete'd, see server/app.ts) must
    // never read back as "active" just because the doc is gone — an ID token
    // issued before the delete stays cryptographically valid for up to ~1h,
    // and Firestore rules never check live revocation, only signature/expiry.
    // Confirmed safe against registration: AuthScreen.tsx awaits
    // dbFirebase.createUserProfile() before any subcollection write is ever
    // reachable, so there's no legitimate case needing the old fail-open
    // window (see security_spec.md Payload 13, tests/firestore.rules.test.mjs).
    function isUserActive(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.status == 'active';
    }

    // ==========================================
    // ENTITY VALIDATION SCHEMAS
    // ==========================================

    // NOTE: `userId` here is the /users/{userId} path segment, not necessarily
    // request.auth.uid — an admin editing someone else's profile has
    // request.auth.uid == the admin's own uid, while `userId` is the target's.
    // createdAt is intentionally NOT re-asserted against request.time here: the
    // `create` rule enforces that at creation time, while `update` separately
    // enforces incoming().createdAt == existing().createdAt (immutability).
    function isValidUser(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'email', 'role', 'status', 'createdAt']) &&
             data.keys().hasOnly(['userId', 'name', 'email', 'role', 'status', 'createdAt', 'freeTrialUntil', 'subscriptionStatus', 'subscriptionPlan', 'subscriptionCurrentPeriodEnd', 'avatarUrl', 'scanLimitExempt', 'trialPrescriptionScansUsed', 'trialReceiptScansUsed']) &&
             data.userId == userId &&
             data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ['user', 'admin'] &&
             data.status in ['active', 'suspended'] &&
             data.createdAt is timestamp &&
             (!('freeTrialUntil' in data) || (data.freeTrialUntil is string && data.freeTrialUntil.size() <= 64)) &&
             (!('subscriptionStatus' in data) || data.subscriptionStatus in ['active', 'inactive', 'expired']) &&
             (!('subscriptionPlan' in data) || data.subscriptionPlan in ['monthly', 'yearly', 'none']) &&
             (!('subscriptionCurrentPeriodEnd' in data) || (data.subscriptionCurrentPeriodEnd is string && data.subscriptionCurrentPeriodEnd.size() <= 64)) &&
             (!('scanLimitExempt' in data) || data.scanLimitExempt is bool) &&
             (!('trialPrescriptionScansUsed' in data) || data.trialPrescriptionScansUsed is number) &&
             (!('trialReceiptScansUsed' in data) || data.trialReceiptScansUsed is number) &&
             (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500000));
    }

    function isValidMedicado(data, userId) {
      return data.keys().hasAll(['medicadoId', 'userId', 'name', 'relationship', 'createdAt']) &&
             data.keys().hasOnly(['medicadoId', 'userId', 'name', 'relationship', 'createdAt', 'photoUrl', 'birthDate', 'memberUids', 'editorUids']) &&
             data.userId == userId &&
             isValidShareLists(data) &&
             data.medicadoId is string && data.medicadoId.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.relationship is string && data.relationship.size() <= 64 &&
             data.createdAt == request.time &&
             (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 32)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500000));
    }

    function isValidReceita(data, userId, medicadoId) {
      return data.keys().hasAll(['receitaId', 'medicadoId', 'userId', 'date', 'extracted', 'createdAt']) &&
             data.keys().hasOnly(['receitaId', 'medicadoId', 'userId', 'date', 'extracted', 'createdAt', 'doctorName', 'imageUrl', 'notes', 'memberUids', 'editorUids']) &&
             data.userId == userId &&
             isValidShareLists(data) &&
             data.medicadoId == medicadoId &&
             data.receitaId is string && data.receitaId.size() <= 128 &&
             data.date is string && data.date.size() <= 32 &&
             data.extracted is bool &&
             data.createdAt == request.time &&
             (!('doctorName' in data) || (data.doctorName is string && data.doctorName.size() <= 128)) &&
             (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidMedicamento(data, userId, medicadoId) {
      return data.keys().hasAll(['medicamentoId', 'receitaId', 'medicadoId', 'userId', 'name', 'dosage', 'intervalHours', 'durationDays', 'category', 'status', 'createdAt']) &&
             data.keys().hasOnly(['medicamentoId', 'receitaId', 'medicadoId', 'userId', 'name', 'dosage', 'intervalHours', 'durationDays', 'category', 'status', 'createdAt', 'instructions', 'pharmacyId', 'reminderOffset', 'pricePlaceholder', 'memberUids', 'editorUids']) &&
             data.userId == userId &&
             isValidShareLists(data) &&
             data.medicadoId == medicadoId &&
             data.medicamentoId is string && data.medicamentoId.size() <= 128 &&
             data.receitaId is string && data.receitaId.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.dosage is string && data.dosage.size() <= 64 &&
             data.intervalHours is int && data.intervalHours > 0 && data.intervalHours <= 168 &&
             data.durationDays is int && data.durationDays > 0 && data.durationDays <= 365 &&
             data.category in ['pill', 'syrup', 'drop', 'cream', 'injection', 'other'] &&
             data.status in ['active', 'completed', 'paused'] &&
             data.createdAt == request.time &&
             (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 2000)) &&
             (!('pharmacyId' in data) || (data.pharmacyId is string && data.pharmacyId.size() <= 128)) &&
             (!('reminderOffset' in data) || (data.reminderOffset is int && data.reminderOffset >= 0 && data.reminderOffset <= 1440)) &&
             (!('pricePlaceholder' in data) || (data.pricePlaceholder is number && data.pricePlaceholder >= 0));
    }

    // `registradoPor` é forçado a ser o uid autenticado que está escrevendo, e
    // não um valor livre. Essa é a garantia que sustenta o cenário do cuidador
    // contratado: "quem marcou esta dose" não é falsificável pelo cliente, nem
    // pelo titular em nome do cuidador, nem pelo cuidador em nome do titular.
    function isValidDoseLog(data, userId, medicadoId, medicamentoId) {
      return data.keys().hasAll(['logId', 'medicamentoId', 'medicadoId', 'userId', 'plannedTime', 'takenTime', 'status']) &&
             data.keys().hasOnly(['logId', 'medicamentoId', 'medicadoId', 'userId', 'plannedTime', 'takenTime', 'status', 'registradoPor', 'memberUids', 'editorUids']) &&
             data.userId == userId &&
             data.medicadoId == medicadoId &&
             data.medicamentoId == medicamentoId &&
             isValidShareLists(data) &&
             (!('registradoPor' in data) || data.registradoPor == request.auth.uid) &&
             data.logId is string && data.logId.size() <= 128 &&
             data.plannedTime is string && data.plannedTime.size() <= 64 &&
             data.takenTime is string && data.takenTime.size() <= 64 &&
             data.status in ['taken', 'missed', 'skipped'];
    }

    function isValidConsulta(data, userId) {
      return data.keys().hasAll(['consultaId', 'userId', 'medicadoId', 'doctorName', 'dateTime', 'createdAt']) &&
             data.keys().hasOnly(['consultaId', 'userId', 'medicadoId', 'doctorName', 'dateTime', 'createdAt', 'specialty', 'location', 'notes', 'memberUids', 'editorUids']) &&
             data.userId == userId &&
             isValidShareLists(data) &&
             data.consultaId is string && data.consultaId.size() <= 128 &&
             data.medicadoId is string && data.medicadoId.size() <= 128 &&
             data.doctorName is string && data.doctorName.size() <= 128 &&
             data.dateTime is string && data.dateTime.size() <= 64 &&
             data.createdAt == request.time &&
             (!('specialty' in data) || (data.specialty is string && data.specialty.size() <= 128)) &&
             (!('location' in data) || (data.location is string && data.location.size() <= 256)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidFarmacia(data, userId) {
      return data.keys().hasAll(['farmaciaId', 'userId', 'name']) &&
             data.keys().hasOnly(['farmaciaId', 'userId', 'name', 'address', 'phone', 'isFavorite']) &&
             data.userId == userId &&
             data.farmaciaId is string && data.farmaciaId.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             (!('address' in data) || (data.address is string && data.address.size() <= 256)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
             (!('isFavorite' in data) || data.isFavorite is bool);
    }

    function isValidCupom(data, userId) {
      return data.keys().hasAll(['cupomId', 'userId', 'establishment', 'date', 'items', 'totalPrice', 'createdAt']) &&
             data.keys().hasOnly(['cupomId', 'userId', 'establishment', 'date', 'items', 'totalPrice', 'createdAt']) &&
             data.userId == userId &&
             data.cupomId is string && data.cupomId.size() <= 128 &&
             data.establishment is string && data.establishment.size() <= 128 &&
             data.date is string && data.date.size() <= 64 &&
             data.items is list && data.items.size() <= 100 &&
             data.totalPrice is number && data.totalPrice >= 0 &&
             data.createdAt == request.time;
    }

    // Trilha de auditoria de alteração/exclusão de registros (Admin Portal).
    // entityLabel NÃO pode nomear dado de saúde de terceiro: para entidades de
    // saúde (Medicado, Receita, Medicamento, Consulta, CupomFiscal) o cliente
    // grava o próprio entityId — ver HEALTH_ENTITY_TYPES em src/App.tsx.
    // `expiresAt` é opcional (e não obrigatório) de propósito: torná-lo
    // obrigatório rejeitaria escritas de uma aba antiga com o JS anterior em
    // cache. Alimenta a política de TTL nativa do Firestore.
    function isValidActionLog(data) {
      return data.keys().hasAll(['logId', 'actorId', 'actorName', 'actorEmail', 'action', 'entityType', 'entityId', 'entityLabel', 'page', 'createdAt']) &&
             data.keys().hasOnly(['logId', 'actorId', 'actorName', 'actorEmail', 'action', 'entityType', 'entityId', 'entityLabel', 'page', 'changesSummary', 'createdAt', 'expiresAt']) &&
             (!('expiresAt' in data) || data.expiresAt is timestamp) &&
             data.logId is string && data.logId.size() <= 128 &&
             data.actorId is string && data.actorId.size() <= 128 &&
             data.actorName is string && data.actorName.size() <= 128 &&
             data.actorEmail is string && data.actorEmail.size() <= 128 &&
             data.action in ['update', 'delete'] &&
             data.entityType is string && data.entityType.size() <= 64 &&
             data.entityId is string && data.entityId.size() <= 128 &&
             data.entityLabel is string && data.entityLabel.size() <= 256 &&
             data.page is string && data.page.size() <= 64 &&
             (!('changesSummary' in data) || (data.changesSummary is string && data.changesSummary.size() <= 1000)) &&
             data.createdAt == request.time;
    }

    // ==========================================
    // RESOURCE ROUTES & ACTIONS
    // ==========================================

    // 1. Users Collection
    match /users/{userId} {
      // Admins can see/list all profiles. Standard users can only view their own profile.
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      // Creating a user profile
      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidUser(incoming(), userId) &&
                       incoming().createdAt == request.time &&
                       // Prevent self-privilege escalation during creation
                       (incoming().role == 'user' || isAdmin()) &&
                       (incoming().status == 'active' || isAdmin());

      // Updating a user profile
      allow update: if isSignedIn() &&
                       isValidUser(incoming(), userId) &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Admins can edit everything (role, status, trial, subscription, etc.)
                         isAdmin() ||
                         (
                           request.auth.uid == userId &&
                           isUserActive(userId) &&
                           // Users cannot alter their own role, status, trial or subscription
                           incoming().role == existing().role &&
                           incoming().status == existing().status &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'avatarUrl'])
                         )
                       );

      // Only admins can delete profiles
      allow delete: if isAdmin();

      // 2. Medicados Subcollection (Patients)
      match /medicados/{medicadoId} {
        allow get: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin()) && isValidId(medicadoId);
        allow list: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin());

        // Só o titular cadastra pacientes; um convidado não traz gente nova
        // para dentro da conta de outra pessoa. As listas de acesso não podem
        // vir do cliente nem aqui — quem as escreve é o aceite do convite.
        allow create: if isOwner(userId) &&
                         isUserActive(userId) &&
                         isValidId(medicadoId) &&
                         isValidMedicado(incoming(), userId) &&
                         hasNoShareLists(incoming());

        allow update: if isSignedIn() &&
                         (isOwner(userId) || isEditor(existing())) &&
                         isUserActive(userId) &&
                         isValidId(medicadoId) &&
                         isValidMedicado(incoming(), userId) &&
                         incoming().createdAt == existing().createdAt &&
                         shareListsUnchanged() &&
                         incoming().diff(existing()).affectedKeys().hasAny(['name', 'relationship', 'photoUrl', 'birthDate']);

        // Excluir o paciente é do titular. Um coadministrador cuida do
        // tratamento, não descarta o prontuário de quem não é dele.
        allow delete: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(medicadoId);

        // 3. Receitas Subcollection (Prescriptions)
        match /receitas/{receitaId} {
          allow get: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin()) && isValidId(receitaId);
          allow list: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin());

          // O `exists()` do medicado pai PRECISA ficar aqui, explícito. Não dá
          // para confiar que `inheritsShareLists` leia o pai e falhe sozinho
          // quando o paciente não existe: para o titular, `incoming()` não tem
          // as listas de acesso, o `||` de dentro dela curto-circuita e o
          // `get()` nunca chega a ser avaliado. Deixar por conta dela reabre o
          // Payload 8 do security_spec.md (receita para paciente fantasma).
          allow create: if isSignedIn() &&
                           isUserActive(userId) &&
                           isValidId(receitaId) &&
                           isValidReceita(incoming(), userId, medicadoId) &&
                           exists(/databases/$(database)/documents/users/$(userId)/medicados/$(medicadoId)) &&
                           (isOwner(userId) || isEditor(medicadoData(userId, medicadoId))) &&
                           inheritsShareLists(incoming(), medicadoData(userId, medicadoId));

          allow update: if isSignedIn() &&
                           (isOwner(userId) || isEditor(existing())) &&
                           isUserActive(userId) &&
                           isValidId(receitaId) &&
                           isValidReceita(incoming(), userId, medicadoId) &&
                           incoming().createdAt == existing().createdAt &&
                           shareListsUnchanged() &&
                           incoming().diff(existing()).affectedKeys().hasAny(['date', 'doctorName', 'imageUrl', 'notes', 'extracted']);

          allow delete: if isSignedIn() && (isOwner(userId) || isEditor(existing()) || isAdmin()) && isValidId(receitaId);
        }

        // 4. Medicamentos Subcollection (Medicines)
        match /medicamentos/{medicamentoId} {
          allow get: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin()) && isValidId(medicamentoId);
          allow list: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin());

          // exists() explícito pelo mesmo motivo da receita acima.
          allow create: if isSignedIn() &&
                           isUserActive(userId) &&
                           isValidId(medicamentoId) &&
                           isValidMedicamento(incoming(), userId, medicadoId) &&
                           exists(/databases/$(database)/documents/users/$(userId)/medicados/$(medicadoId)) &&
                           (isOwner(userId) || isEditor(medicadoData(userId, medicadoId))) &&
                           inheritsShareLists(incoming(), medicadoData(userId, medicadoId));

          allow update: if isSignedIn() &&
                           (isOwner(userId) || isEditor(existing())) &&
                           isUserActive(userId) &&
                           isValidId(medicamentoId) &&
                           isValidMedicamento(incoming(), userId, medicadoId) &&
                           incoming().createdAt == existing().createdAt &&
                           shareListsUnchanged() &&
                           incoming().diff(existing()).affectedKeys().hasAny(['name', 'dosage', 'intervalHours', 'durationDays', 'instructions', 'category', 'pharmacyId', 'status', 'reminderOffset', 'pricePlaceholder']);

          allow delete: if isSignedIn() && (isOwner(userId) || isEditor(existing()) || isAdmin()) && isValidId(medicamentoId);

          // 5. DoseLogs Subcollection (Logs of medication intake)
          // Registrar dose é privativo do titular e do coadministrador. O
          // acompanhante (filho à distância) lê a adesão e não escreve nada:
          // é o `isEditor` — e não o `isMember` — que aparece aqui.
          //
          // `registradoPor` fica OPCIONAL de propósito, pelo mesmo motivo do
          // `expiresAt` em isValidActionLog: torná-lo obrigatório rejeitaria a
          // escrita de uma aba antiga com o JS anterior em cache. Falsificar
          // não dá — o validador amarra o campo ao uid autenticado.
          match /doseLogs/{logId} {
            allow get: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin()) && isValidId(logId);
            allow list: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin());

            allow create: if isSignedIn() &&
                             isUserActive(userId) &&
                             isValidId(logId) &&
                             isValidDoseLog(incoming(), userId, medicadoId, medicamentoId) &&
                             (isOwner(userId) || isEditor(medicadoData(userId, medicadoId))) &&
                             inheritsShareLists(incoming(), medicadoData(userId, medicadoId)) &&
                             exists(/databases/$(database)/documents/users/$(userId)/medicados/$(medicadoId)/medicamentos/$(medicamentoId));

            allow update: if isSignedIn() &&
                             (isOwner(userId) || isEditor(existing())) &&
                             isUserActive(userId) &&
                             isValidId(logId) &&
                             isValidDoseLog(incoming(), userId, medicadoId, medicamentoId) &&
                             shareListsUnchanged() &&
                             incoming().diff(existing()).affectedKeys().hasAny(['takenTime', 'status', 'registradoPor']);

            allow delete: if isSignedIn() && (isOwner(userId) || isEditor(existing()) || isAdmin()) && isValidId(logId);
          }
        }
      }

      // 6. Consultas Subcollection (Doctor Appointments)
      // Consultas ficam soltas sob /users/{userId} e apontam para o paciente via
      // `medicadoId`, então o pai contra o qual as listas de acesso são
      // conferidas vem do próprio documento.
      //
      // Aqui NÃO há `exists()` do medicado — como não havia antes. A criação de
      // consulta pelo titular segue sem exigir paciente existente; só o caminho
      // compartilhado acaba lendo o pai (porque aí `incoming()` traz as listas e
      // a comparação em inheritsShareLists é de fato avaliada). Manter a paridade
      // é deliberado: apertar isto agora mudaria comportamento sem necessidade.
      match /consultas/{consultaId} {
        allow get: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin()) && isValidId(consultaId);
        allow list: if isSignedIn() && (isOwner(userId) || isMember(existing()) || isAdmin());

        allow create: if isSignedIn() &&
                         isUserActive(userId) &&
                         isValidId(consultaId) &&
                         isValidConsulta(incoming(), userId) &&
                         isValidId(incoming().medicadoId) &&
                         (isOwner(userId) || isEditor(medicadoData(userId, incoming().medicadoId))) &&
                         inheritsShareLists(incoming(), medicadoData(userId, incoming().medicadoId));

        allow update: if isSignedIn() &&
                         (isOwner(userId) || isEditor(existing())) &&
                         isUserActive(userId) &&
                         isValidId(consultaId) &&
                         isValidConsulta(incoming(), userId) &&
                         incoming().createdAt == existing().createdAt &&
                         shareListsUnchanged() &&
                         incoming().diff(existing()).affectedKeys().hasAny(['doctorName', 'specialty', 'dateTime', 'location', 'notes', 'medicadoId']);

        allow delete: if isSignedIn() && (isOwner(userId) || isEditor(existing()) || isAdmin()) && isValidId(consultaId);
      }

      // 7. Farmacias Subcollection (Pharmacy database entries)
      match /farmacias/{farmaciaId} {
        allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(farmaciaId);
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() && 
                         request.auth.uid == userId && 
                         isUserActive(userId) &&
                         isValidId(farmaciaId) && 
                         isValidFarmacia(incoming(), userId);

        allow update: if isSignedIn() && 
                         request.auth.uid == userId && 
                         isUserActive(userId) &&
                         isValidId(farmaciaId) && 
                         isValidFarmacia(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasAny(['name', 'address', 'phone', 'isFavorite']);

        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(farmaciaId);
      }

      // 8. Cupons Subcollection
      match /cupons/{cupomId} {
        allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(cupomId);
        allow list: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        allow create: if isSignedIn() &&
                         request.auth.uid == userId &&
                         isUserActive(userId) &&
                         isValidId(cupomId) &&
                         isValidCupom(incoming(), userId);

        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && isValidId(cupomId);
      }

      // 9. Push Subscriptions Subcollection (Web Push / VAPID endpoints)
      // Written EXCLUSIVELY server-side via the Admin SDK (which bypasses these
      // rules) using the authenticated uid — see /api/push/subscribe in
      // server.ts. Clients get zero write access so a browser can never forge,
      // move, or tamper with a subscription; the owner may read/delete their own
      // (e.g. to audit or clear devices). This preserves per-user isolation:
      // one user's push endpoints are never readable or writable by another.
      match /pushSubscriptions/{subId} {
        allow get, list: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if false;
      }

      // 10. Push Dispatch Markers (per-dose dedupe for the Web Push dispatcher).
      // Written and read EXCLUSIVELY server-side via the Admin SDK (which
      // bypasses these rules) so a serverless cold start / second instance can't
      // re-send a reminder already sent. Clients get zero access. (The global
      // default-deny already blocks this; the explicit rule documents intent.)
      match /pushDispatches/{dispatchId} {
        allow read, write: if false;
      }
    }

    // ==========================================
    // COMPARTILHAMENTO ENTRE CUIDADORES (top-level, cross-user)
    // ==========================================

    // Convite de acesso a UM medicado. Precisa ser top-level porque o convidado
    // ainda não tem permissão nenhuma dentro da árvore do titular no momento em
    // que recebe o convite — é justamente este documento que ele lê para saber
    // que existe algo a aceitar.
    //
    // Legível pelo titular e pelo convidado, por uid quando ele já aceitou e
    // por e-mail enquanto o convite está pendente (antes do aceite não há uid
    // resolvido). `granteeUid` e o e-mail do token são acessados sob guarda:
    // ler campo ausente em regra é erro, e erro nega a operação inteira.
    //
    // Escrita ZERO para o cliente. Não é excesso de zelo: aceitar um convite
    // propaga as listas de acesso por toda a subárvore do medicado, e só o
    // Admin SDK (que bypassa estas regras) pode fazer isso de forma atômica.
    // Se o cliente pudesse escrever aqui, poderia se autoconceder acesso.
    match /shares/{shareId} {
      allow get, list: if isSignedIn() && (
                          resource.data.ownerUid == request.auth.uid ||
                          (('granteeUid' in resource.data) && resource.data.granteeUid == request.auth.uid) ||
                          (request.auth.token.email != null && resource.data.granteeEmail == request.auth.token.email)
                       );
      allow create, update, delete: if false;
    }

    // ==========================================
    // ADMIN AUDIT LOGS (top-level, cross-user — feed the Admin Portal "Logs" tab)
    // ==========================================

    // Alteração/exclusão de registros. Escrito pelo client no momento da
    // mutação (único lugar que sabe com certeza quem é o ator); trilha
    // imutável — nunca pode ser atualizada ou apagada, nem pelo autor.
    match /actionLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() &&
                       incoming().actorId == request.auth.uid &&
                       isValidId(logId) &&
                       isValidActionLog(incoming());
      allow update, delete: if false;
    }

    // Login de usuário e erros de servidor. Escritos EXCLUSIVAMENTE via
    // Admin SDK (bypassa estas regras) porque só o servidor conhece o IP
    // real do cliente e o stack trace do erro. Zero acesso de escrita do client.
    match /loginLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /errorLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
